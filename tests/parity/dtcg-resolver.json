{
  "version": "2025.10",
  "name": "Parity",
  "sets": {
    "base": {
      "sources": [{ "size": { "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } } } }]
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [{ "surface": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } } }],
        "dark": [{ "surface": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } } }]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/base" },
    { "type": "set", "name": "overrides", "sources": [{ "size": { "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } } } }] },
    { "$ref": "#/modifiers/theme" }
  ]
}
