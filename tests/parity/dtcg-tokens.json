{
  "color": {
    "$type": "color",
    "hex": { "$value": { "colorSpace": "srgb", "components": [1, 0, 1], "hex": "#ff00ff" } },
    "srgb": { "$value": { "colorSpace": "srgb", "components": [1, 0, 0.5], "alpha": 0.5, "hex": "#ff0080" } },
    "hsl": { "$value": { "colorSpace": "hsl", "components": ["none", 0, 100] } },
    "oklch": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.2, 260] } },
    "sky": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.1, { "$ref": "#/color/oklch/$value/components/2" }] } },
    "link": { "$value": { "$ref": "#/color/oklch/$value" } },
    "brand": { "$value": "{color.oklch}" }
  },
  "spacing": {
    "$type": "dimension",
    "$root": { "$value": { "value": 4, "unit": "px" } },
    "lg": { "$value": { "value": 0.5, "unit": "rem" } }
  },
  "gap": { "$value": "{spacing.$root}" },
  "ease": { "$type": "cubicBezier", "in": { "$value": [0.5, 0, 1, 1] } },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Helvetica Neue", "sans-serif"] },
    "weight": { "$type": "fontWeight", "$value": "semi-bold" }
  },
  "border": {
    "$type": "border",
    "$value": { "color": "{color.brand}", "width": { "value": 1, "unit": "px" }, "style": "solid" }
  },
  "transition": {
    "$type": "transition",
    "$value": {
      "duration": { "value": 200, "unit": "ms" },
      "delay": { "value": 0, "unit": "ms" },
      "timingFunction": [0.5, 0, 1, 1]
    }
  },
  "shadow": {
    "$type": "shadow",
    "$value": [
      { "color": "{color.hex}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": "{color.hex}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "inset": true }
    ]
  },
  "gradient": {
    "$type": "gradient",
    "$value": [
      { "color": "{color.hex}", "position": 0 },
      { "color": "{color.brand}", "position": 0.5 }
    ]
  },
  "heading": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.family}",
      "fontSize": { "value": 42, "unit": "px" },
      "fontWeight": 700,
      "lineHeight": 1.2
    }
  },
  "button": {
    "$type": "dimension",
    "padding": { "$value": { "value": 4, "unit": "px" } },
    "radius": { "$value": { "value": 2, "unit": "px" } }
  },
  "button-lg": {
    "$extends": "{button}",
    "padding": { "$value": { "value": 8, "unit": "px" } }
  }
}
